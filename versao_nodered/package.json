      "fanuc-pmc-read": "nodes/fanuc-pmc-read.js",
      "fanuc-pmc-write": "nodes/fanuc-pmc-write.js",
      "fanuc-param-read": "nodes/fanuc-param-read.js",
      "fanuc-param-write": "nodes/fanuc-param-write.js",
      "fanuc-status": "nodes/fanuc-status.js",
      "fanuc-custom": "nodes/fanuc-custom.js"
    }
  },
  "dependencies": {
    "node-opcua": "^2.115.0"
  },
  "repository": {
