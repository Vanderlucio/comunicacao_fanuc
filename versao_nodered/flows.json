    "broker": "127.0.0.1",
    "port": "1883",
    "clientid": "NodeRED_Fanuc_Bridge",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "autoUnsubscribe": true,
    "birthTopic": "factory/fanuc/cnc01/status",
    "birthQos": "1",
    "birthRetain": "true",
    "birthPayload": "{\"status\":\"online\"}",
    "birthMsg": {},
    "closeTopic": "factory/fanuc/cnc01/status",
