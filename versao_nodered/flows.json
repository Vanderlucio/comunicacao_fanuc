    "id": "mqtt_out_node",
    "type": "mqtt out",
    "z": "tab_fanuc_mqtt",
    "name": "Publicar em MQTT Broker",
    "topic": "factory/fanuc/cnc01/telemetry",
    "qos": "1",
    "retain": "true",
    "respTopic": "",
    "contentType": "",
    "userProps": "",
    "correl": "",
    "expiry": "",
    "broker": "mqtt_broker_local",
    "x": 650,
    "y": 140,
    "wires": []
  },
  {
    "id": "mqtt_broker_local",
    "type": "mqtt-broker",
