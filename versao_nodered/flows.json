  {
    "id": "fn_prepare_mqtt",
    "type": "function",
    "z": "tab_fanuc_mqtt",
    "name": "Formatar Payload MQTT",
    "func": "const data = msg.payload && msg.payload.status ? msg.payload.status : {};\n\nmsg.topic = 'factory/fanuc/cnc01/telemetry';\nmsg.payload = {\n  timestamp: new Date().toISOString(),\n  machineId: 'FANUC_CNC_01',\n  connected: data.connected || false,\n  mode: data.mode || 'UNKNOWN',\n  runStatus: data.runStatus || 'UNKNOWN',\n  spindleRpm: data.spindleSpeed || 0,\n  feedrate: data.feedrate || 0,\n  partsProduced: data.partsCount || 0,\n  activeProgram: data.program || '---',\n  positions: data.positions || { X: 0, Y: 0, Z: 0, A: 0 }\n};\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 140,
    "wires": [
      [
        "mqtt_out_node"
      ]
    ]
  },
