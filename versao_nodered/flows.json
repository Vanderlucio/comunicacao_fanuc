  {
    "id": "http_get_status",
    "type": "http request",
    "z": "tab_fanuc_telemetry",
    "name": "GET /api/status",
    "method": "GET",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "http://127.0.0.1:3000/api/status",
    "tls": "",
    "persist": false,
    "proxy": "",
    "authType": "",
    "x": 320,
    "y": 120,
    "wires": [
      [
        "fn_parse_telemetry",
        "fn_prepare_mqtt"
      ]
    ]
  },
  {
    "id": "fn_parse_telemetry",
    "type": "function",
    "z": "tab_fanuc_telemetry",
    "name": "Processar Telemetria",
    "func": "const status = msg.payload && msg.payload.status ? msg.payload.status : {};\n\nreturn [\n  { payload: Number(status.spindleSpeed) || 0, topic: 'spindle' },\n  { payload: Number(status.feedrate) || 0, topic: 'feedrate' },\n  { payload: status.positions && status.positions.X !== undefined ? Number(status.positions.X).toFixed(3) : '---', topic: 'axis_x' },\n  { payload: status.positions && status.positions.Y !== undefined ? Number(status.positions.Y).toFixed(3) : '---', topic: 'axis_y' },\n  { payload: status.positions && status.positions.Z !== undefined ? Number(status.positions.Z).toFixed(3) : '---', topic: 'axis_z' },\n  { payload: status.partsCount !== undefined ? Number(status.partsCount) : 0, topic: 'parts' },\n  { payload: status.program || '---', topic: 'program' },\n  { payload: status.mode || '---', topic: 'mode' },\n  { payload: status.runStatus || '---', topic: 'runStatus' }\n];",
    "outputs": 9,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 540,
    "y": 120,
    "wires": [
      [
        "ui_gauge_spindle"
      ],
      [
        "ui_gauge_feedrate"
      ],
      [
        "ui_text_x"
      ],
      [
        "ui_text_y"
      ],
      [
        "ui_text_z"
      ],
      [
        "ui_text_parts"
      ],
      [
        "ui_text_program"
      ],
      [
        "ui_text_mode"
      ],
      [
        "ui_text_run"
      ]
    ]
  },
